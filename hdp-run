def launch_environment() -> dict[str, str]:
    """Resolve a credential once, then populate every child field explicitly."""
    from core.home import leanflow_home
    from leanflow_cli.config import load_env_file
    from leanflow_cli.runtime.env_loader import NATIVE_AUXILIARY_PROVIDER_TARGETS

    file_values = load_env_file()
    key = ""
    key_pool = []
    for values in (os.environ, file_values):
        raw_pool = str(values.get("M2F_CODEX_API_KEYS", "") or "").strip()
        if raw_pool and not key_pool:
            key_pool = [candidate.strip() for candidate in raw_pool.split(",") if candidate.strip()]
    # A scale child explicitly carries a slot, so prefer the configured pool
    # even when the parent shell still exports a legacy single key.
    if key_pool and "HDP_WORKER_SLOT" in os.environ:
        slot = int(str(os.environ.get("HDP_WORKER_SLOT", "0") or "0"))
        key = key_pool[slot % len(key_pool)]
    else:
        for values in (os.environ, file_values):
            key = str(values.get("M2F_CODEX_API_KEY", "") or "").strip()
            if key:
                break
            if key_pool:
                key = key_pool[0]
                break
            for prefix in ("LEANFLOW_OPENAI", "OPENAI"):
                endpoint = str(values.get(f"{prefix}_BASE_URL", "") or "").rstrip("/")
                candidate = str(values.get(f"{prefix}_API_KEY", "") or "").strip()
                if candidate and endpoint == BASE_URL:
                    key = candidate
                    break
            if key:
                break
    if not key:
        raise RuntimeError(
            "Set M2F_CODEX_API_KEY, or configure a zcloud endpoint/key in "
            f"{leanflow_home() / '.env'}; no credential was found."
        )
    key_fingerprint = hashlib.sha256(key.encode()).hexdigest()
    if key_fingerprint not in AUTHORIZED_KEY_SHA256S:
        raise RuntimeError("The configured zcloud credential does not match the authorized key.")

    env = dict(os.environ)
    env.update(
        {
            "LEANFLOW_HOME": str(leanflow_home()),
            "PYTHONPATH": str(SOURCE),
            "PYTHONUNBUFFERED": "1",
            "M2F_CODEX_API_KEY": key,
            "HDP_EXPECTED_KEY_SHA256": key_fingerprint,
            "LEANFLOW_OPENAI_API_KEY": key,
            "LEANFLOW_OPENAI_BASE_URL": BASE_URL,
            "OPENAI_API_KEY": key,
            "OPENAI_BASE_URL": BASE_URL,
            "OPENAI_MODEL": MODEL,
            "LEANFLOW_INFERENCE_PROVIDER": "custom",
            "LEANFLOW_NATIVE_PROVIDER": "custom",
            "LEANFLOW_NATIVE_API_MODE": "chat_completions",
            "LEANFLOW_NATIVE_API_KEY": key,
            "LEANFLOW_NATIVE_BASE_URL": BASE_URL,
            "LEANFLOW_NATIVE_MODEL": MODEL,
            "LEANFLOW_NATIVE_REASONING_EFFORT": "high",
            "LEANFLOW_NATIVE_AUXILIARY_PROVIDER": "custom",
            "LEANFLOW_NATIVE_AUXILIARY_API_KEY": key,
            "LEANFLOW_NATIVE_AUXILIARY_BASE_URL": BASE_URL,
            "LEANFLOW_NATIVE_AUXILIARY_MODEL": MODEL,
            "LEANFLOW_NATIVE_AUXILIARY_REASONING_EFFORT": "high",
            "LEANFLOW_PROJECT_ROOT": str(PROJECT),
            "TERMINAL_ENV": "ssh",
            "TERMINAL_SSH_HOST": "140.143.244.199",
            "TERMINAL_SSH_USER": "hrm",
            "TERMINAL_SSH_PORT": "49322",
            "TERMINAL_SSH_KEY": "/Users/blackbox/.ssh/ap_lean_hrm_140_143_244_199",
            "TERMINAL_SSH_PERSISTENT": "true",
            "TERMINAL_SSH_SYNC_PROJECT": "true",
            "TERMINAL_CWD": REMOTE_ROOT,
            "TERMINAL_SSH_CWD": REMOTE_ROOT,
            "FILE_ENV": "local",
            "FILE_CWD": str(PROJECT),
            "LEAN_PROBE_LAKE_PATH": str(LAKE),
            "LEANFLOW_LAKE_EXECUTABLE": str(LAKE),
            "PATH": os.pathsep.join(
                (str(SOURCE / "remote-bin"), str(PYTHON.parent), env.get("PATH", ""))
            ),
        }
    )
    for name in (
        "TERMINAL_TIMEOUT",
        "LEANFLOW_API_TIMEOUT",
        "LEANFLOW_ADVISORY_VERIFICATION_TIMEOUT_S",
        "LEANFLOW_REMOTE_LEAN_TIMEOUT_S",
    ):
        env[name] = "600"
    for provider_name in NATIVE_AUXILIARY_PROVIDER_TARGETS:
        prefix = provider_name.removesuffix("_PROVIDER")
        for suffix, value in (
            ("PROVIDER", "custom"),
            ("BASE_URL", BASE_URL),
            ("API_KEY", key),
            ("MODEL", MODEL),
            ("REASONING_EFFORT", "high"),
        ):
            env[f"{prefix}_{suffix}"] = value
    return env


