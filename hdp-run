def main() -> int:
    """Check child configuration without network, or run an explicit campaign command."""
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--check", action="store_true", help="check a real child; no API or Lean calls"
    )
    parser.add_argument("--campaign", type=Path, default=PROJECT / "HDP/Environments/campaign.json")
    options, forwarded = parser.parse_known_args()
    fixed = {
        "--project-root": str(PROJECT),
        "--lake-executable": str(LAKE),
        "--reasoning-effort": "high",
        "--review-timeout-seconds": "600",
        "--statement-compile-timeout-seconds": "600",
    }
    for prefix in (
        "",
        "statement-",
        "statement-planner-",
        "statement-fallback-",
        "statement-judge-",
        "review-",
    ):
        fixed[f"--{prefix}provider"] = "custom"
        fixed[f"--{prefix}model"] = MODEL
    fixed["--proof-model"] = MODEL
    fixed["--escalation-model"] = MODEL
    for arg in forwarded:
        option = arg.partition("=")[0]
        # argparse accepts unambiguous long-option abbreviations downstream.
        # Reject prefixes too, so --batch-item-li cannot bypass this boundary.
        if option.startswith("--") and any(
            protected.startswith(option) for protected in (*fixed, "--batch-item-limit")
        ):
            parser.error(f"{option} is fixed or prohibited by the HDP launcher")
    if options.check and forwarded:
        parser.error("--check cannot be combined with campaign runner arguments")
    campaign = options.campaign.expanduser().resolve()
    if not campaign.is_relative_to(PROJECT):
        parser.error("campaign must stay inside the local HDP project")
    try:
        env = launch_environment()
    except RuntimeError as exc:
        parser.error(str(exc))
    check = subprocess.run([str(PYTHON), "-c", CHECK_CODE], cwd=PROJECT, env=env, check=False)
    if options.check or check.returncode:
        return check.returncode
    command = [
        str(PYTHON),
        "-m",
        "leanflow_cli.formalization.corpus_campaign_runner",
        str(campaign),
    ]
    command.extend(forwarded)
    for name, value in fixed.items():
        command.extend((name, value))
    os.chdir(PROJECT)
    os.execve(PYTHON, command, env)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
