def utc() -> str:
    return datetime.now(UTC).isoformat(timespec="seconds")


def digest(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def load(path: Path) -> dict:
    return json.loads(path.read_bytes())


def summary(campaign: dict) -> dict:
    """Separate accepted statements, integration receipts, and completed proofs."""
    batches = campaign.get("batches", [])
    return {
        "batches": len(batches),
        "statement_accepted": sum(
            any(
                a.get("stage") == "statements" and a.get("success")
                for a in b.get("attempts", [])
            )
            for b in batches
        ),
        "root_integrated_statements": sum(
            any(
                a.get("stage") == "statements"
                and a.get("success")
                and a.get("root_reachable") is True
                for a in b.get("attempts", [])
            )
            for b in batches
        ),
        "proofs_completed": sum(
            b.get("status") in {"completed", "proofs_completed"} for b in batches
        ),
        "leases": [b["id"] for b in batches if b.get("lease")],
        "ledger_spent_usd": campaign.get("spent_usd"),
        "cost_note": "Unknown pricing is not zero cost; raw provider quota is guarded separately.",
    }


def preview(
    campaign_path: Path, project: Path, excluded: set[str], limit: int
) -> list[dict]:
    """Use pure rebuild, reconciliation, and exact lease previews without ledger writes."""
    current = load(campaign_path)
    manifest = campaign_path.with_name("book-manifest.json")
    current = (
        build_campaign(load(manifest), existing=current)
        if manifest.is_file()
        else current
    )
    current, _ = reconcile_campaign_targets(current, project_root=project)
    packets = {}
    candidates = []
    for batch in current["batches"]:
        if batch["id"] in excluded or statement_escalation_pending(batch):
            continue
        if batch.get("agent_status", batch.get("status")) not in {
            "pending",
            "statement_retry",
        }:
            continue
        labels = batch.get("labels", [])
        if len(labels) != 1:
            continue
        path = (
            project / (batch.get("source_file") or current.get("source", ""))
        ).resolve()
        if (
            not path.is_relative_to(project)
            or not path.is_file()
            or path.suffix != ".json"
        ):
            continue
        if path not in packets:
            data = load(path)
            rows = data.get("questions", []) if isinstance(data, dict) else data
            if not isinstance(rows, list):
                continue
            indexed = {}
            for row in rows:
                if isinstance(row, dict):
                    indexed.setdefault(str(row.get("label", "")), []).append(row)
            packets[path] = (indexed, digest(path.read_bytes()))
        matches = packets[path][0].get(str(labels[0]), [])
        if len(matches) != 1:
            continue
        item = matches[0]
        statement = str(item.get("question", item.get("statement", "")) or "").strip()
        if not statement or statement_scope_preflight(
            statement, kind=str(item.get("kind", ""))
        ):
            continue
        attempts = [
            a for a in batch.get("attempts", []) if a.get("stage") == "statements"
        ]
        candidates.append(
            (len(attempts), len(statement), batch["id"], path, statement, batch)
        )
    selected = []
    for _, _, batch_id, path, statement, batch in sorted(
        candidates, key=lambda value: value[:3]
    ):
        proposed, leased = lease_campaign_batches(
            current,
            stage="statements",
            worker_ids=[f"preview-{len(selected)}"],
            batch_id=batch_id,
        )
        if not leased:
            continue
        current = proposed
        selected.append(
            {
                "batch_id": batch_id,
                "source_file": str(path.relative_to(project)),
                "source_sha256": packets[path][1],
                "statement_sha256": digest(statement.encode()),
                "statement_preview": statement[:240],
                "complexity": batch.get("source_complexity_tier", "routine"),
                "attempts_before": len(batch.get("attempts", [])),
                "dependencies": batch.get("dependency_labels", []),
            }
        )
        if len(selected) >= limit:
            break
    return selected


