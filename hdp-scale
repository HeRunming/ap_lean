def _truthy_env(value: str) -> bool:
    return str(value or "").strip().lower() in {"1", "true", "yes", "on"}


def key_pool_metadata(env: dict[str, str] | None = None) -> dict[str, object]:
    """Return credential-pool cardinality and fingerprints without exposing keys."""
    values = dict(env or os.environ)
    if not str(values.get("M2F_CODEX_API_KEYS", "") or "").strip():
        try:
            from leanflow_cli.config import load_env_file

            values.update(load_env_file())
        except (OSError, ValueError):
            pass
    raw = str(values.get("M2F_CODEX_API_KEYS", "") or "")
    keys = [item.strip() for item in raw.split(",") if item.strip()]
    fingerprints = sorted({hashlib.sha256(item.encode()).hexdigest() for item in keys})
    return {
        "key_pool_size": len(keys),
        "key_fingerprint_count": len(fingerprints),
        "key_fingerprints": fingerprints,
    }


def no_infrastructure_fuse_setting(cli_enabled: bool) -> tuple[bool, str]:
    """Resolve the temporary fuse bypass and retain its explicit origin."""
    env_enabled = _truthy_env(os.environ.get(NO_INFRASTRUCTURE_FUSE_ENV, ""))
    if cli_enabled and env_enabled:
        return True, "cli+env"
    if cli_enabled:
        return True, "cli"
    if env_enabled:
        return True, "env"
    return False, "default"


def digest(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def load(path: Path) -> dict:
    return json.loads(path.read_bytes())


def inspect_proof_target(
    project: Path,
    target_file: str,
    *,
    root_reachability: dict | None = None,
    allow_proof_retry: bool = False,
) -> dict[str, object]:
    """Classify a generated Lean target before admitting a paid proof action.

    Existence alone is insufficient: old campaigns left tiny ``import Mathlib``
    scaffolds and stale proof receipts behind.  A candidate must contain an
    actual declaration, a proof placeholder (or an explicit failed proof retry),
    and be reachable from the public project root.  This check is deliberately
    textual; remote Lean remains the authority for proving the resulting file.
    """
    root = project.expanduser().resolve()
    target = (root / str(target_file or "")).resolve()
    result: dict[str, object] = {
        "target_file": str(target_file or ""),
        "target_exists": False,
        "has_declaration": False,
        "has_placeholder": False,
        "explicit_proof_retry": bool(allow_proof_retry),
        "only_import_shell": False,
        "root_reachable": None,
        "eligible": False,
        "reason": "missing_target",
    }
    if not target.is_relative_to(root):
        result["reason"] = "invalid_target_path"
        return result
    if not target.is_file() or target.suffix.lower() != ".lean":
        return result
    result["target_exists"] = True
    try:
        source = target.read_text(encoding="utf-8")
    except (OSError, UnicodeError):
        result["reason"] = "unreadable_target"
        return result
    sanitized = _strip_lean_comments_and_strings(source)
    has_declaration = bool(_LEAN_DECLARATION_RE.search(sanitized))
    has_placeholder = bool(_LEAN_PLACEHOLDER_RE.search(sanitized))
    result["has_declaration"] = has_declaration
    result["has_placeholder"] = has_placeholder
    result["only_import_shell"] = not has_declaration
    reachability = root_reachability or project_target_reachability(project, target_file)
    result["root_reachable"] = reachability.get("root_reachable")
    root_reachable = reachability.get("root_reachable") is True
    if not has_declaration:
        result["reason"] = "empty_import_shell"
    elif not has_placeholder and not allow_proof_retry:
        result["reason"] = "no_proof_placeholder"
    elif not root_reachable:
        result["reason"] = "root_unreachable"
    else:
        result["eligible"] = True
        result["reason"] = "eligible"
    return result


def summary(campaign: dict) -> dict:
    """Separate accepted statements, integration receipts, and completed proofs."""
    batches = campaign.get("batches", [])
    return {
        "batches": len(batches),
        "statement_accepted": sum(
            any(a.get("stage") == "statements" and a.get("success") for a in b.get("attempts", []))
            for b in batches
        ),
        "root_integrated_statements": sum(
            any(
                a.get("stage") == "statements"
                and a.get("success")
                and a.get("root_reachable") is True
                for a in b.get("attempts", [])
            )
            for b in batches
        ),
        "proofs_completed": sum(
            b.get("status") in {"completed", "proofs_completed"} for b in batches
        ),
        "leases": [b["id"] for b in batches if b.get("lease")],
        "ledger_spent_usd": campaign.get("spent_usd"),
        "cost_note": "Unknown pricing is not zero cost; raw provider quota is guarded separately.",
    }


def preview(
    campaign_path: Path,
    project: Path,
    excluded: set[str],
    limit: int,
    *,
    stage: str = "statements",
    active_stages: tuple[str, ...] = (),
) -> list[dict]:
    """Use pure rebuild, reconciliation, and exact lease previews without ledger writes."""
    if stage == "mixed":
        selected = []
        occupied = list(active_stages)
        used = set(excluded)
        pools = {
            lane: preview(campaign_path, project, used, limit, stage=lane)
            for lane in ("proofs", "statements")
        }
        while len(selected) < limit:
            lanes = sorted(pools, key=lambda lane: occupied.count(lane))
            for lane in lanes:
                pools[lane] = [row for row in pools[lane] if row["batch_id"] not in used]
                if pools[lane]:
                    item = pools[lane].pop(0)
                    selected.append(item)
                    occupied.append(lane)
                    used.add(item["batch_id"])
                    break
            else:
                break
        return selected
    current = load(campaign_path)
    manifest = campaign_path.with_name("book-manifest.json")
    current = build_campaign(load(manifest), existing=current) if manifest.is_file() else current
    current, _ = reconcile_campaign_targets(current, project_root=project)
    packets = {}
    candidates = []
    eligible_statuses = (
        {"pending", "statement_retry"}
        if stage == "statements"
        else {"statements_completed", "proof_retry"}
    )
    for batch in current["batches"]:
        if batch["id"] in excluded or statement_escalation_pending(batch):
            continue
        if batch.get("agent_status", batch.get("status")) not in eligible_statuses:
            continue
        target_file = ""
        target_check = {}
        if stage == "proofs":
            proof_retry_semantics = batch.get(
                "agent_status", batch.get("status")
            ) == "proof_retry" and any(
                isinstance(attempt, dict)
                and attempt.get("stage") == "proofs"
                and attempt.get("success") is False
                and not attempt.get("reconciled_stale")
                for attempt in batch.get("attempts", [])
            )
            target_file = str(
                dict(batch.get("last_outcome", {}) or {}).get("target_file", "") or ""
            ).strip()
            if not target_file:
                continue
            target = (project / target_file).resolve()
            if not target.is_relative_to(project) or not target.is_file():
                continue
            # Reject empty scaffolds and completed files before the relatively
            # expensive project-wide import-closure scan.
            target_check = inspect_proof_target(
                project,
                target_file,
                root_reachability={"root_reachable": None},
                allow_proof_retry=proof_retry_semantics,
            )
            if not target_check["has_declaration"] or (
                not target_check["has_placeholder"] and not proof_retry_semantics
            ):
                continue
            reachability = project_target_reachability(project, target_file)
            target_check = inspect_proof_target(
                project,
                target_file,
                root_reachability=reachability,
                allow_proof_retry=proof_retry_semantics,
            )
            if not target_check["eligible"]:
                continue
        else:
            reachability = {}
        labels = batch.get("labels", [])
        if len(labels) != 1:
            continue
        item = {}
        path = project
        if stage == "statements":
            path = (project / (batch.get("source_file") or current.get("source", ""))).resolve()
            if not path.is_relative_to(project) or not path.is_file() or path.suffix != ".json":
                continue
            if path not in packets:
                data = load(path)
                rows = data.get("questions", []) if isinstance(data, dict) else data
                if not isinstance(rows, list):
                    continue
                indexed = {}
                for row in rows:
                    if isinstance(row, dict):
                        indexed.setdefault(str(row.get("label", "")), []).append(row)
                packets[path] = (indexed, digest(path.read_bytes()))
            matches = packets[path][0].get(str(labels[0]), [])
            if len(matches) != 1:
                continue
            item = matches[0]
            statement = str(item.get("question", item.get("statement", "")) or "").strip()
            if not statement or statement_scope_preflight(
                statement, kind=str(item.get("kind", ""))
            ):
                continue
        else:
            statement = target_file
        attempts = [a for a in batch.get("attempts", []) if a.get("stage") == "statements"]
        candidates.append(
            (
                len(attempts),
                len(statement),
                batch["id"],
                path,
                statement,
                batch,
                target_file,
                reachability,
                target_check,
            )
        )
    selected = []
    for (
        _,
        _,
        batch_id,
        path,
        statement,
        batch,
        target_file,
        reachability,
        target_check,
    ) in sorted(candidates, key=lambda value: value[:3]):
        proposed, leased = lease_campaign_batches(
            current,
            stage=stage,
            worker_ids=[f"preview-{len(selected)}"],
            batch_id=batch_id,
        )
        if not leased:
            continue
        current = proposed
        selected.append(
            {
                "batch_id": batch_id,
                "source_file": str(path.relative_to(project)),
                "source_sha256": packets[path][1] if stage == "statements" else "",
                "statement_sha256": digest(statement.encode()),
                "statement_preview": statement[:240],
                "complexity": batch.get("source_complexity_tier", "routine"),
                "attempts_before": len(batch.get("attempts", [])),
                "dependencies": batch.get("dependency_labels", []),
                "stage": stage,
                "target_file": target_file,
                "root_reachability": reachability,
                **({"target_check": target_check} if stage == "proofs" else {}),
            }
        )
        if len(selected) >= limit:
            break
    return selected


