def verified_quote_snapshot(path: Path) -> tuple[bytes, dict]:
    """Validate the exact quote bytes and the current HDP reservation policy."""
    from agent.accounting.provider_quota import ProviderQuotaError, ProviderQuotaQuote

    try:
        contents = path.read_bytes()
        payload = json.loads(contents)
    except (OSError, ValueError) as exc:
        raise ProviderQuotaError("provider quota quote is missing or invalid") from exc
    if not isinstance(payload, dict):
        raise ProviderQuotaError("provider quota quote must be a JSON object")
    quote = ProviderQuotaQuote.from_mapping(payload)
    if (quote.base_url, quote.model) != ("https://api.zcloudapi.com/v1", "gpt-6-astra"):
        raise RuntimeError("quota quote must match the fixed HDP provider and model")
    if not Path(quote.evidence_path).is_file():
        raise RuntimeError("quota quote needs local provider evidence")
    for name in ("provider_input_allowance_tokens", "provider_output_allowance_tokens"):
        if name not in payload or getattr(quote, name) < MIN_PROVIDER_ALLOWANCE_TOKENS:
            raise ProviderQuotaError(
                f"quota quote requires explicit {name} >= {MIN_PROVIDER_ALLOWANCE_TOKENS}; "
                "use the current verified quote instead of an outdated run snapshot"
            )
    return contents, {
        "sha256": digest(contents),
        "base_url": quote.base_url,
        "model": quote.model,
        "pricing_version": quote.pricing_version,
        "provider_input_allowance_tokens": quote.provider_input_allowance_tokens,
        "provider_output_allowance_tokens": quote.provider_output_allowance_tokens,
    }


def minimum_request_quota(path: Path) -> int:
    """Compute the provider allowance floor without making or reserving a request."""
    from agent.accounting.provider_quota import ProviderQuotaQuote

    raw, _metadata = verified_quote_snapshot(path)
    quote = ProviderQuotaQuote.from_mapping(json.loads(raw))
    return quote.estimate_quota(
        base_url=quote.base_url,
        model=quote.model,
        group=quote.group,
        prompt_tokens=max(768, quote.provider_input_allowance_tokens),
        completion_tokens=max(1, quote.provider_output_allowance_tokens),
    )


def quota_environment(options, run_dir: Path) -> dict[str, str]:
    """Require verified raw-quota accounting before admitting paid child processes."""
    # The provider module owns validation, request reservations, and reconciliation.
    # This import stays out of dry-run planning, which never contacts a provider.
    from agent.accounting.provider_quota_budget import (
        initialize_quota_budget,
        read_quota_budget,
    )

    contents, _metadata = verified_quote_snapshot(options.quote)
    snapshot = run_dir / "quota-quote.json"
    snapshot.write_bytes(contents)
    # The budget is deliberately outside the per-run directory so every
    # controller wave shares one cumulative provider-quota ledger.  Operators
    # may override this path for an explicitly isolated campaign.
    budget = getattr(options, "quota_budget", None)
    if budget is None:
        budget = options.project / ".leanflow" / "scale-budget.json"
    budget = Path(budget).expanduser().resolve()
    initialize_quota_budget(budget, limit_quota=options.quota_limit)
    state = read_quota_budget(
        budget,
        ignore_unknown_holds=bool(getattr(options, "ignore_unknown_holds", False)),
    )
    if state.get("halt_reason"):
        raise RuntimeError(
            "quota budget is halted; reconcile it before starting another wave: "
            + str(state["halt_reason"])
        )
    return {
        "LEANFLOW_PROVIDER_QUOTA_BUDGET_PATH": str(budget),
        "LEANFLOW_PROVIDER_QUOTA_QUOTE_PATH": str(snapshot),
        "LEANFLOW_PROVIDER_AUDIT_PATH": str(run_dir / "provider-audit.jsonl"),
        "LEANFLOW_AUXILIARY_RETRY_COUNT": "0",
        "LEANFLOW_AUXILIARY_TIMEOUT_RETRY_COUNT": "0",
        IGNORE_UNKNOWN_HOLDS_ENV: ("1" if getattr(options, "ignore_unknown_holds", False) else "0"),
    }


def quota_quote_status(options, env: dict) -> dict:
    """Record the quote snapshot that paid children will actually consume."""
    snapshot = Path(env["LEANFLOW_PROVIDER_QUOTA_QUOTE_PATH"])
    _contents, metadata = verified_quote_snapshot(snapshot)
    return {
        "source_path": str(options.quote.expanduser().resolve()),
        "snapshot_path": str(snapshot),
        **metadata,
    }


def quota_status(env: dict) -> dict:
    from agent.accounting.provider_quota_budget import read_quota_budget

    ignore_unknown = _truthy_env(env.get(IGNORE_UNKNOWN_HOLDS_ENV, ""))
    state = read_quota_budget(
        env["LEANFLOW_PROVIDER_QUOTA_BUDGET_PATH"],
        ignore_unknown_holds=ignore_unknown,
    )
    return {
        key: state.get(key)
        for key in (
            "unit",
            "limit_quota",
            "charges_quota",
            "held_quota",
            "remaining_quota",
            "halt_reason",
            "unknown_hold_quota",
            "effective_held_quota",
            "quota_accounting_mode",
        )
    }


def import_halted_quota_budget(source: Path, destination: Path) -> dict:
    """Copy a halted budget for an explicitly acknowledged new controller wave.

    The source is never modified.  Clearing ``halt_reason`` is intentionally
    available only through this explicit offline command and acknowledgement;
    all charges, holds, and request reservations remain part of the imported
    ledger.
    """
    from agent.accounting.provider_quota_budget import read_quota_budget

    source = source.expanduser().resolve()
    destination = destination.expanduser().resolve()
    if source == destination:
        raise RuntimeError("quota budget import requires distinct source and destination")
    if destination.exists():
        raise RuntimeError("quota budget destination already exists")
    state = read_quota_budget(source)
    halt = str(state.get("halt_reason", "") or "")
    if not halt:
        raise RuntimeError("source quota budget is not halted; import is only for halted budgets")
    source_sha = digest(source.read_bytes())
    state.pop("halt_reason", None)
    state["imported_from"] = str(source)
    state["imported_from_sha256"] = source_sha
    state["import_acknowledged_at"] = utc()
    destination.parent.mkdir(parents=True, exist_ok=True)
    atomic_json_write(destination, state)
    return read_quota_budget(destination)


def _operator_authorized_at(value: str) -> str:
    """Validate an operator authorization time before it enters the ledger."""
    try:
        authorized_at = datetime.fromisoformat(str(value or "").strip())
    except ValueError as exc:
        raise ValueError("operator authorization time must be ISO-8601 with timezone") from exc
    if authorized_at.tzinfo is None:
        raise ValueError("operator authorization time must include a timezone")
    normalized = authorized_at.astimezone(UTC)
    if normalized > datetime.now(UTC) + timedelta(minutes=5):
        raise ValueError("operator authorization time cannot be in the future")
    return normalized.isoformat()


def isolated_budget_source_summary(state: dict) -> dict:
    """Summarize an immutable prior ledger without copying its reservations."""
    reservations = state.get("reservations", {})
    statuses: dict[str, int] = {}
    unknown_hold_quota = 0
    if isinstance(reservations, dict):
        for item in reservations.values():
            if not isinstance(item, dict):
                continue
            status = str(item.get("status", ""))
            statuses[status] = statuses.get(status, 0) + 1
            if status == "unknown":
                unknown_hold_quota += int(item.get("reserved_quota", 0) or 0)
    return {
        "limit_quota": state["limit_quota"],
        "charges_quota": state["charges_quota"],
        "held_quota": state["held_quota"],
        "remaining_quota": state["remaining_quota"],
        "halt_reason": str(state.get("halt_reason", "") or ""),
        "reservation_status_counts": statuses,
        "unknown_hold_quota": unknown_hold_quota,
    }


def create_isolated_operator_budget(
    source: Path,
    destination: Path,
    *,
    limit_quota: int,
    authorization_ref: str,
    authorized_at: str,
    quote_metadata: dict,
) -> dict:
    """Create a new wave ledger linked to, but never derived from, wave3.

    New provider capacity is an operator-authorized raw-quota allocation.  The
    historical ledger remains immutable: its charges and unresolved holds are
    recorded as linkage evidence rather than copied into the new capacity.
    """
    from agent.accounting.provider_quota_budget import read_quota_budget

    source = source.expanduser().resolve()
    destination = destination.expanduser().resolve()
    if source == destination:
        raise RuntimeError("isolated budget must not replace its source ledger")
    if destination.exists():
        raise RuntimeError("isolated budget destination already exists")
    if isinstance(limit_quota, bool) or not isinstance(limit_quota, int) or limit_quota <= 0:
        raise ValueError("isolated raw provider quota limit must be positive")
    reference = str(authorization_ref or "").strip()
    if not reference or len(reference) > 256:
        raise ValueError("operator authorization reference must be 1-256 characters")
    source_state = read_quota_budget(source)
    source_bytes = source.read_bytes()
    destination.parent.mkdir(parents=True, exist_ok=True)
    record = {
        "version": 1,
        "unit": "provider_quota",
        "limit_quota": limit_quota,
        "charges_quota": 0,
        "reservations": {},
        "created_at": utc(),
        "operator_authorization": {
            "reference": reference,
            "authorized_at_utc": _operator_authorized_at(authorized_at),
            "raw_quota_limit_source": "operator_authorized_new_provider_quota",
        },
        "isolated_from": {
            "wave": source.stem.removesuffix("-scale-budget") or source.stem,
            "source_path": str(source),
            "source_sha256": digest(source_bytes),
            "source_summary": isolated_budget_source_summary(source_state),
        },
        "provider_quota_evidence": dict(quote_metadata),
    }
    atomic_json_write(destination, record)
    return read_quota_budget(destination)


def execute(options, *, popen=subprocess.Popen, clock=time.monotonic, pause=time.sleep) -> dict:
    """Fill bounded worker slots, then drain on limits or infrastructure failures."""
    project, campaign = options.project, options.campaign
    with controller_lock(project):
        run_dir = (
            project / ".leanflow" / "scale-runs" / datetime.now(UTC).strftime("%Y%m%dT%H%M%SZ")
        )
        run_dir.mkdir(parents=True, exist_ok=False)
        before = campaign.read_bytes()
        (run_dir / "campaign-before.json").write_bytes(before)
        env = {**os.environ, **quota_environment(options, run_dir)}
        effective_quota = quota_status(env)
        effective_quote = (
            quota_quote_status(options, env)
            if env.get("LEANFLOW_PROVIDER_QUOTA_QUOTE_PATH")
            else {}
        )
        baseline = summary(json.loads(before))
        hashes = source_hashes()
        no_infrastructure_fuse = bool(getattr(options, "no_infrastructure_fuse", False))
        fuse_source = str(getattr(options, "no_infrastructure_fuse_source", "") or "") or (
            "explicit_option" if no_infrastructure_fuse else "default"
        )
        state = {
            "started_at": utc(),
            "controller_pid": os.getpid(),
            "workers": options.workers,
            "stage": getattr(options, "stage", "statements"),
            **key_pool_metadata(env),
            "lean_slots": 1,
            "max_items": options.max_items,
            "max_wall_minutes": options.max_wall,
            "per_request_timeout_seconds": PER_REQUEST_TIMEOUT_SECONDS,
            "quota_limit_raw": effective_quota.get("limit_quota", options.quota_limit),
            "quota_budget_path": env.get("LEANFLOW_PROVIDER_QUOTA_BUDGET_PATH", ""),
            "quota_quote": effective_quote,
            "quota_before": dict(effective_quota),
            "quota": effective_quota,
            "source_sha256": hashes,
            "campaign_before_sha256": digest(before),
            "before": baseline,
            "items": [],
            "active": {},
            "stop_reason": "",
            "no_infrastructure_fuse": no_infrastructure_fuse,
            "no_infrastructure_fuse_source": fuse_source,
            "infrastructure_fuse_threshold": INFRASTRUCTURE_FUSE_THRESHOLD,
            "ignore_unknown_holds": bool(getattr(options, "ignore_unknown_holds", False)),
            "quota_accounting_mode": (
                "success_only"
                if getattr(options, "ignore_unknown_holds", False)
                else "conservative"
            ),
            "infrastructure_failure_streak": 0,
        }
        active = {}
        seen = set()
        started = clock()
        heartbeat_at = started - 30
        infra_streak = 0

        def event(kind: str, **fields):
            record = {"utc": utc(), "event": kind, **fields}
            with (run_dir / "events.jsonl").open("a") as handle:
                handle.write(json.dumps(record, ensure_ascii=False) + "\n")
            state["active"] = {key: value[0].pid for key, value in active.items()}
            atomic_json_write(run_dir / "run.json", state)
            print(json.dumps(record, ensure_ascii=False), flush=True)

        def stop(reason: str):
            if not state["stop_reason"]:
                state["stop_reason"] = reason
                event("stop_dispatch", reason=reason)

        def on_signal(signum, _frame):
            stop(f"signal_{signum}")

        old_signals = {
            sig: signal.signal(sig, on_signal) for sig in (signal.SIGINT, signal.SIGTERM)
        }
        event(
            "started",
            directory=str(run_dir),
            no_infrastructure_fuse=no_infrastructure_fuse,
            no_infrastructure_fuse_source=fuse_source,
            infrastructure_fuse_enabled=not no_infrastructure_fuse,
            infrastructure_fuse_threshold=INFRASTRUCTURE_FUSE_THRESHOLD,
            ignore_unknown_holds=bool(getattr(options, "ignore_unknown_holds", False)),
            quota_accounting_mode=state["quota"].get("quota_accounting_mode", "conservative"),
            unknown_hold_quota=state["quota"].get("unknown_hold_quota", 0),
            per_request_timeout_seconds=PER_REQUEST_TIMEOUT_SECONDS,
            **baseline,
        )
        try:
            while True:
                for batch_id, (process, item) in list(active.items()):
                    exit_code = process.poll()
                    if exit_code is None:
                        continue
                    current = load(campaign)
                    batch = next((b for b in current["batches"] if b["id"] == batch_id), {})
                    attempts = item_receipts(item, batch)
                    # A directly killed child can exit before the campaign
                    # runner's Python finally block writes its outcome. Recover
                    # the still-owned lease here so the next retry sees an
                    # explicit aborted/inflight infrastructure attempt.
                    if exit_code is not None and exit_code < 0 and not attempts:
                        lease = batch.get("lease") if isinstance(batch, dict) else None
                        worker_id = (
                            str(lease.get("worker_id", "") or "") if isinstance(lease, dict) else ""
                        )
                        if worker_id:
                            action = CampaignAction(
                                stage=str(item.get("stage", "statements") or "statements"),
                                batch_id=batch_id,
                                labels=tuple(str(label) for label in batch.get("labels", []) or []),
                                argv=tuple(item.get("command", []) or []),
                                target_file=str(
                                    dict(batch.get("last_outcome", {}) or {}).get("target_file", "")
                                    or ""
                                ),
                            )
                            signum = -exit_code
                            _record_campaign_interruption(
                                campaign,
                                action=action,
                                worker_id=worker_id,
                                error=InterruptedError(
                                    f"child process interrupted by signal {signum}"
                                ),
                            )
                            current = load(campaign)
                            batch = next(
                                (b for b in current["batches"] if b["id"] == batch_id),
                                {},
                            )
                            attempts = item_receipts(item, batch)
                    kind = failure_kind(attempts, exit_code)
                    item.update(
                        {
                            "finished_at": utc(),
                            "exit_code": exit_code,
                            "classification": kind,
                            "new_attempts": attempts,
                            "lease_after": batch.get("lease"),
                        }
                    )
                    if not attempts:
                        item["receipt_recovery"] = _missing_receipt_recovery(item, batch, exit_code)
                    else:
                        item["receipt_recovery"] = {
                            "kind": "receipt_present",
                            "safe_to_retry": False,
                            "manual_reconciliation_required": False,
                        }
                    del active[batch_id]
                    infra_streak = infra_streak + 1 if kind == "infrastructure" else 0
                    state["infrastructure_failure_streak"] = infra_streak
                    event(
                        "item_finished",
                        batch_id=batch_id,
                        classification=kind,
                        exit_code=exit_code,
                        infrastructure_failure_streak=infra_streak,
                        no_infrastructure_fuse=no_infrastructure_fuse,
                    )
                    if kind in {"auth", "quota", "rate_limit"}:
                        stop(kind)
                    elif (
                        infra_streak >= INFRASTRUCTURE_FUSE_THRESHOLD and not no_infrastructure_fuse
                    ):
                        stop("consecutive_infrastructure_failures")
                    elif infra_streak >= INFRASTRUCTURE_FUSE_THRESHOLD and no_infrastructure_fuse:
                        event(
                            "infrastructure_fuse_bypassed",
                            infrastructure_failure_streak=infra_streak,
                            threshold=INFRASTRUCTURE_FUSE_THRESHOLD,
                            no_infrastructure_fuse=True,
                        )
                    elif batch.get("lease"):
                        stop("lease_not_released")
                if clock() - started >= options.max_wall * 60:
                    stop("wall_limit")
                if (run_dir / "STOP").exists() or (
                    getattr(options, "supervisor_stop_file", None) is not None
                    and options.supervisor_stop_file.exists()
                ):
                    stop("stop_file")
                if len(seen) >= options.max_items:
                    stop("item_limit")
                state["quota"] = quota_status(env)
                if (
                    state["quota"].get("halt_reason")
                    or state["quota"].get("remaining_quota", 0) <= 0
                ):
                    stop("quota")
                if not state["stop_reason"] and len(active) < options.workers:
                    if source_hashes() != hashes:
                        stop("source_changed")
                    else:
                        slots = min(options.workers - len(active), options.max_items - len(seen))
                        choices = preview(
                            campaign,
                            project,
                            seen | set(getattr(options, "excluded_batches", ())),
                            slots,
                            stage=getattr(options, "stage", "statements"),
                            **(
                                {
                                    "active_stages": tuple(
                                        item["stage"] for _, item in active.values()
                                    )
                                }
                                if getattr(options, "stage", "statements") == "mixed"
                                else {}
                            ),
                        )
                        if not choices and not active:
                            stop("no_eligible_unseen_items")
                        for item in choices:
                            batch_id = item["batch_id"]
                            seen.add(batch_id)
                            item.setdefault("stage", getattr(options, "stage", "statements"))
                            item["command"] = command(campaign, batch_id, stage=item["stage"])
                            item["started_at"] = utc()
                            target_path = (
                                (project / str(item.get("target_file", ""))).resolve()
                                if item.get("target_file")
                                else None
                            )
                            item["target_path"] = str(target_path) if target_path else ""
                            item["target_sha256_before"] = (
                                _file_digest(target_path) if target_path else None
                            )
                            item["recovery_source_before"] = recovery_snapshot(item["target_path"])
                            current_batch = next(
                                b for b in load(campaign)["batches"] if b["id"] == batch_id
                            )
                            item["attempts_before_sha256"] = digest(
                                json.dumps(
                                    current_batch.get("attempts", []), sort_keys=True
                                ).encode()
                            )
                            item["log"] = str(
                                run_dir
                                / f"{len(seen):03d}-{re.sub(r'[^A-Za-z0-9_.-]', '_', batch_id)}.log"
                            )
                            with Path(item["log"]).open("w") as log:
                                # Bind each child to a deterministic credential
                                # pool slot.  hdp-run resolves the corresponding
                                # key from M2F_CODEX_API_KEYS and records only its
                                # fingerprint in check telemetry.
                                child_env = dict(env)
                                child_env["HDP_WORKER_SLOT"] = str(
                                    (len(seen) - 1) % options.workers
                                )
                                process = popen(
                                    item["command"],
                                    cwd=project,
                                    env=child_env,
                                    stdin=subprocess.DEVNULL,
                                    stdout=log,
                                    stderr=subprocess.STDOUT,
                                    start_new_session=True,
                                )
                            item["pid"] = process.pid
                            state["items"].append(item)
                            active[batch_id] = (process, item)
                            event(
                                "item_started",
                                batch_id=batch_id,
                                pid=process.pid,
                                log=item["log"],
                                stage=item["stage"],
                            )
                if clock() - heartbeat_at >= 30:
                    event(
                        "heartbeat",
                        active=state["active"],
                        launched=len(seen),
                        completed=len(seen) - len(active),
                        stop_reason=state["stop_reason"],
                        quota=state["quota"],
                    )
                    heartbeat_at = clock()
                if state["stop_reason"] and not active:
                    break
                pause(1)
        except Exception as exc:
            stop(f"controller_error: {type(exc).__name__}: {exc}")
            # Do not abandon paid workers or release the supervisor lock while they run.
            for process, _item in active.values():
                process.wait()
            raise
        finally:
            for sig, handler in old_signals.items():
                signal.signal(sig, handler)
            after = campaign.read_bytes()
            (run_dir / "campaign-after.json").write_bytes(after)
            state.update(
                {
                    "finished_at": utc(),
                    "campaign_after_sha256": digest(after),
                    "after": summary(json.loads(after)),
                }
            )
            atomic_json_write(run_dir / "run.json", state)
        reconcile_missing_receipts(state, campaign)
        event("finished", stop_reason=state["stop_reason"], after=state["after"])
        return state


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--execute", action="store_true", help="otherwise print an offline dry plan"
    )
    parser.add_argument("--campaign", type=Path, default=PROJECT / "HDP/Environments/campaign.json")
    parser.add_argument(
        "--stage",
        choices=("statements", "proofs", "mixed"),
        default="statements",
        help="dispatch statements, proofs, or balanced mixed lanes with shared worker slots",
    )
    parser.add_argument("--workers", type=int, choices=(1, 2, 4, 8), default=4)
    parser.add_argument("--max-items", type=int, default=24)
    parser.add_argument(
        "--max-wall", type=float, default=180, help="minutes before stopping dispatch"
    )
    parser.add_argument(
        "--no-infrastructure-fuse",
        action="store_true",
        help=(
            "explicitly continue dispatch after consecutive infrastructure failures; "
            "quota, lease, wall-time and item limits remain enforced"
        ),
    )
    parser.add_argument(
        "--ignore-unknown-holds",
        action="store_true",
        help=(
            "opt in to success-only quota admission: retain unknown reservations as "
            "evidence but exclude their holds from remaining capacity"
        ),
    )
    parser.add_argument(
        "--quota-limit", type=int, default=2_000_000, help="raw provider quota units"
    )
    parser.add_argument(
        "--quote",
        type=Path,
        default=CANONICAL_QUOTA_QUOTE,
        help="verified provider raw-quota quote JSON (default: canonical pricing evidence)",
    )
    parser.add_argument(
        "--quota-budget",
        type=Path,
        help="persistent cumulative raw-quota ledger (default: PROJECT/.leanflow/scale-budget.json)",
    )
    parser.add_argument(
        "--import-quota-budget",
        type=Path,
        help="offline copy of a halted budget; requires --acknowledge-overrun",
    )
    parser.add_argument(
        "--acknowledge-overrun",
        action="store_true",
        help="acknowledge an explicitly imported overrun budget",
    )
    parser.add_argument(
        "--create-isolated-quota-budget",
        action="store_true",
        help="offline-create a fresh operator-authorized quota ledger for a new wave",
    )
    parser.add_argument(
        "--isolated-from-quota-budget",
        type=Path,
        help="source ledger to record as immutable wave linkage evidence",
    )
    parser.add_argument(
        "--operator-authorization-ref",
        help="auditable reference authorizing the new raw-quota allocation",
    )
    parser.add_argument(
        "--operator-authorized-at",
        help="ISO-8601 timestamp (with timezone) of the allocation authorization",
    )
    options = parser.parse_args()
    (
        options.no_infrastructure_fuse,
        options.no_infrastructure_fuse_source,
    ) = no_infrastructure_fuse_setting(options.no_infrastructure_fuse)
    options.project = PROJECT
    if options.quota_budget is not None:
        options.quota_budget = options.quota_budget.expanduser().resolve()
        if not options.quota_budget.is_relative_to(PROJECT):
            parser.error("quota budget must remain inside the unique local HDP checkout")
    if options.import_quota_budget is not None:
        if options.create_isolated_quota_budget:
            parser.error(
                "--import-quota-budget cannot be combined with " "--create-isolated-quota-budget"
            )
        options.import_quota_budget = options.import_quota_budget.expanduser().resolve()
        if not options.import_quota_budget.is_relative_to(PROJECT):
            parser.error("imported quota budget must remain inside the unique local HDP checkout")
        if not options.acknowledge_overrun:
            parser.error("--import-quota-budget requires --acknowledge-overrun")
        destination = options.quota_budget or (PROJECT / ".leanflow" / "scale-budget.json")
        if not destination.is_relative_to(PROJECT):
            parser.error("quota budget must remain inside the unique local HDP checkout")
        try:
            imported = import_halted_quota_budget(options.import_quota_budget, destination)
        except (OSError, RuntimeError, ValueError) as exc:
            parser.error(str(exc))
        print(
            json.dumps(
                {
                    "imported": True,
                    "destination": str(destination),
                    "quota": {
                        k: imported.get(k)
                        for k in (
                            "limit_quota",
                            "charges_quota",
                            "held_quota",
                            "remaining_quota",
                        )
                    },
                },
                ensure_ascii=False,
                indent=2,
            )
        )
        return 0
    if options.create_isolated_quota_budget:
        if options.execute:
            parser.error("--create-isolated-quota-budget is offline-only; omit --execute")
        if options.quota_budget is None:
            parser.error("isolated quota creation requires an explicit --quota-budget destination")
        if options.isolated_from_quota_budget is None:
            parser.error("isolated quota creation requires --isolated-from-quota-budget")
        if not options.operator_authorization_ref:
            parser.error("isolated quota creation requires --operator-authorization-ref")
        if not options.operator_authorized_at:
            parser.error("isolated quota creation requires --operator-authorized-at")
        source = options.isolated_from_quota_budget.expanduser().resolve()
        destination = options.quota_budget
        if not source.is_relative_to(PROJECT):
            parser.error(
                "isolated source quota budget must remain inside the unique local HDP checkout"
            )
        if not destination.is_relative_to(PROJECT):
            parser.error(
                "isolated destination quota budget must remain inside the unique local HDP checkout"
            )
        try:
            _quote_contents, quote_metadata = verified_quote_snapshot(options.quote)
            isolated = create_isolated_operator_budget(
                source,
                destination,
                limit_quota=options.quota_limit,
                authorization_ref=options.operator_authorization_ref,
                authorized_at=options.operator_authorized_at,
                quote_metadata=quote_metadata,
            )
        except (OSError, RuntimeError, ValueError) as exc:
            parser.error(str(exc))
        print(
            json.dumps(
                {
                    "isolated": True,
                    "destination": str(destination),
                    "source": str(source),
                    "operator_authorization": isolated.get("operator_authorization"),
                    "isolated_from": isolated.get("isolated_from"),
                    "provider_quota_evidence": isolated.get("provider_quota_evidence"),
                    "quota": {
                        key: isolated.get(key)
                        for key in (
                            "limit_quota",
                            "charges_quota",
                            "held_quota",
                            "remaining_quota",
                        )
                    },
                },
                ensure_ascii=False,
                indent=2,
            )
        )
        return 0
    options.campaign = options.campaign.expanduser().resolve()
    if not options.campaign.is_relative_to(PROJECT):
        parser.error("campaign must remain inside the unique local HDP checkout")
    if options.max_items < 1 or options.max_wall <= 0 or options.quota_limit < 1:
        parser.error("item, wall-time and quota limits must be positive")
    if options.execute:
        if not options.quote:
            parser.error("execution requires a verified --quote and shared request quota guard")
        result = execute(options)
        return int(
            result["stop_reason"]
            in {"auth", "quota", "rate_limit", "consecutive_infrastructure_failures"}
        )
    before = options.campaign.read_bytes()
    plan = preview(
        options.campaign,
        PROJECT,
        set(),
        options.max_items,
        stage=options.stage,
    )
    print(
        json.dumps(
            {
                "dry_run": True,
                "utc": utc(),
                "workers": options.workers,
                "stage": options.stage,
                "lean_slots": 1,
                "campaign_sha256": digest(before),
                "items": plan,
                "max_items": options.max_items,
                "max_wall_minutes": options.max_wall,
                "no_infrastructure_fuse": options.no_infrastructure_fuse,
                "no_infrastructure_fuse_source": options.no_infrastructure_fuse_source,
                "per_request_timeout_seconds": PER_REQUEST_TIMEOUT_SECONDS,
                "quota_limit_raw": options.quota_limit,
                "cost_note": "No API/Lean calls; execution requires verified raw-quota guard.",
            },
            ensure_ascii=False,
            indent=2,
        )
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
